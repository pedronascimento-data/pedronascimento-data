function adicionarImagensAoFormularioExistente() {
  const candidatos = DriveApp.getFilesByName(TITULO_FORM);
  if (!candidatos.hasNext()) {
    throw new Error('Formulário não encontrado na mesma conta: ' + TITULO_FORM);
  }
  const arquivo = candidatos.next();
  if (candidatos.hasNext()) {
    throw new Error('Há mais de um formulário com este nome. Renomeie os duplicados antes de executar.');
  }
  const form = FormApp.openById(arquivo.getId());
  const localizarPergunta = () => form.getItems().findIndex(i =>
    i.getTitle().startsWith('5. Após observar as telas')
  );
  if (localizarPergunta() < 0) {
    throw new Error('Pergunta 5 não encontrada no formulário escolhido. Nenhuma imagem foi inserida.');
  }
  function inserirImagem(titulo, base64, nomeArquivo) {
    const imagensExistentes = form.getItems(FormApp.ItemType.IMAGE);
    let item = imagensExistentes.find(x => x.getTitle() === titulo);
    if (item) {
      item = item.asImageItem();
    } else {
      const bytes = Utilities.base64Decode(base64);
      const blob = Utilities.newBlob(bytes, 'image/png', nomeArquivo);
      item = form.addImageItem().setTitle(titulo).setImage(blob);
    }
    form.moveItem(item.getIndex(), localizarPergunta());
  }
  inserirImagem(TITULO_IMG_LOGIN, IMG_LOGIN_BASE64, 'Tela_1_Login.png');
  inserirImagem(TITULO_IMG_CADASTRO, IMG_CADASTRO_BASE64, 'Tela_2_Cadastro_de_Alimentos.png');
  form.setAcceptingResponses(true);
  Logger.log('FORMULÁRIO ATUALIZADO: ' + form.getTitle());
  Logger.log('LINK PARA RESPONDER: ' + form.getPublishedUrl());
  Logger.log('RESPOSTAS PRESERVADAS: ' + form.getResponses().length);
  Logger.log('IMAGENS: ' + form.getItems(FormApp.ItemType.IMAGE).length);
}